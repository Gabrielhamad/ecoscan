{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local field manifest generated by build_field_manifest.py; no independence certification",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["path", "class_id", "split", "object_id", "session_id", "license", "consent", "source_kind", "scenario", "lighting", "background", "angle", "sha256", "rgb_sha256", "rgb_shape", "original_mode", "format"],
    "additionalProperties": false,
    "properties": {
      "path": {"type": "string", "description": "Relative POSIX path inside source root; no parent segments or symlink escape"},
      "class_id": {"enum": ["plastic", "metal", "glass", "paper_cardboard", "battery", "electronic", "unknown"]},
      "split": {"enum": ["train", "validation", "test"]},
      "object_id": {"$ref": "#/$defs/token"},
      "session_id": {"$ref": "#/$defs/token"},
      "license": {"enum": ["private-consent", "CC0-1.0", "CC-BY-4.0", "CC-BY-SA-4.0"]},
      "consent": {"const": true},
      "source_kind": {"enum": ["field_photo", "synthetic_fixture"]},
      "scenario": {"enum": ["standard", "transparent_plastic", "transparent_glass", "reflective_metal", "out_of_scope"]},
      "lighting": {"$ref": "#/$defs/token"},
      "background": {"$ref": "#/$defs/token"},
      "angle": {"$ref": "#/$defs/token"},
      "sha256": {"$ref": "#/$defs/sha256"},
      "rgb_sha256": {"$ref": "#/$defs/sha256"},
      "rgb_shape": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 1}, {"type": "integer", "minimum": 1}, {"const": 3}], "minItems": 3, "maxItems": 3},
      "original_mode": {"type": "string"},
      "format": {"enum": ["JPEG", "PNG"]},
      "independent_test": {"const": false}
    }
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
