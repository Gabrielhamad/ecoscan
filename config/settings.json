{
  "project_name": "Recicla SP",
  "image_size": [
    224,
    224
  ],
  "confidence_threshold": 0.65,
  "random_seed": 42,
  "processing": {
    "max_dimension": 640,
    "padding_rgb": 127
  },
  "allowed_extensions": [
    ".jpg",
    ".jpeg",
    ".png"
  ],
  "min_image_size": [
    48,
    48
  ],
  "min_images_per_class_warning": 20,
  "imbalance_ratio_warning": 2,
  "classes": [
    "plastic",
    "paper_cardboard",
    "metal",
    "glass",
    "battery",
    "electronic"
  ],
  "directories": {
    "raw_data": "data/raw",
    "curated_data": "data/curated",
    "processed_data": "data/processed",
    "train_data": "data/train",
    "validation_data": "data/validation",
    "test_data": "data/test",
    "models": "models",
    "reports": "reports",
    "logs": "logs"
  },
  "dataset_split": {
    "train": 0.7,
    "validation": 0.15,
    "test": 0.15
  },
  "model": {
    "engine": "semantic_onnx_assisted",
    "artifact_path": "models/semantic-v1/semantic.json",
    "remote_models_enabled": true,
    "confirmation_required": true
  },
  "history": {
    "enabled": true,
    "path": "logs/history.jsonl",
    "save_images": false
  },
  "filters": {
    "default": "auto",
    "auto": {
      "candidate_sequences": [
        [
          "none"
        ],
        [
          "gaussian"
        ],
        [
          "median"
        ],
        [
          "bilateral"
        ],
        [
          "clahe"
        ]
      ],
      "min_noise_sigma": 4.0,
      "min_impulse_ratio": 0.0005
    },
    "gaussian": {
      "kernel_size": 5,
      "sigma": 1
    },
    "median": {
      "kernel_size": 3
    },
    "bilateral": {
      "diameter": 9,
      "sigma_color": 75,
      "sigma_space": 75
    },
    "clahe": {
      "clip_limit": 2,
      "tile_grid_size": [
        8,
        8
      ]
    },
    "canny": {
      "threshold1": 80,
      "threshold2": 160
    }
  },
  "segmentation": {
    "default": "auto",
    "auto": {
      "candidate_methods": [
        "otsu",
        "grabcut"
      ],
      "min_foreground_ratio": 0.025,
      "max_foreground_ratio": 0.86
    },
    "threshold": {
      "method": "otsu"
    },
    "hsv_color": {
      "saturation_min": 45,
      "value_min": 35
    },
    "grabcut": {
      "iterations": 3,
      "margin_percent": 0.01
    },
    "morphology": {
      "default": "open_close",
      "kernel_size": 3,
      "kernel_shape": "square",
      "iterations": 1
    }
  }
}
